# === Client Twilio Credentials (per-client) ===
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# === Deepgram (STT) ===
DEEPGRAM_API_KEY=xxxx

# === Google Gemini (LLM - free tier) ===
GEMINI_API_KEY=xxxx

# === ElevenLabs (TTS) ===
ELEVENLABS_API_KEY=xxxx
ELEVENLABS_VOICE_ID=xxxx

# === Google Sheets ===
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/service-account.json
GOOGLE_SHEET_ID=xxxx

# === Email (SendGrid) ===
SENDGRID_API_KEY=xxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# === Server ===
PUBLIC_URL=https://your-domain.com
HOST=0.0.0.0
PORT=8000

# === Dashboard ===
# Leave empty to create the password from the dashboard on first run
# (only possible from the server itself, http://localhost:8000).
# For Docker/remote servers, set it here instead.
DASHBOARD_PASSWORD=
# Optional: cross-origin dashboard hosts, comma-separated (default: none)
CORS_ORIGINS=

# === Data & cost model ===
DATA_DIR=data
COST_PER_MINUTE=0.02
INDUSTRY_COST_PER_MINUTE=0.09
